# Copy to `.env` and fill in. `.env` is git-ignored; this file is not, and must
# never contain a real value.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. While developing, use one of Resend's own test
# recipients rather than an invented address: delivered@resend.dev,
# bounced@resend.dev, complained@resend.dev, suppressed@resend.dev
CONTACT_TO_EMAIL=

# The sender. `onboarding@resend.dev` works in development only; production
# requires an address on a domain verified at https://resend.com/domains
CONTACT_FROM_EMAIL=

# The production origin: scheme and host only, with no path, query string or
# trailing slash. Canonical URLs, sitemap entries and social images all resolve
# against it. A missing or malformed value fails `npm run build`; `npm run dev`
# and `npm test` fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Runtime database: Neon pooled (-pooler) PostgreSQL URL. Preserve the provided
# sslmode=require option. Validated only on first server database use, not build.
DATABASE_URL=

# Direct PostgreSQL URL for separately approved `prisma migrate deploy`/Studio.
# Never used by the runtime or as a fallback. Offline Prisma Client and SQL
# generation needs no URL.
DATABASE_URL_UNPOOLED=

# Reserved for later isolated integration tests. Never point it at production;
# the current unit suite does not connect to a database or require this value.
TEST_DATABASE_URL=
