# Copy to `.env` and fill in. `.env` is git-ignored; this file is not, and must
# never contain a real value.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. While developing, use one of Resend's own test
# recipients rather than an invented address: delivered@resend.dev,
# bounced@resend.dev, complained@resend.dev, suppressed@resend.dev
CONTACT_TO_EMAIL=

# The sender. `onboarding@resend.dev` works in development only; production
# requires an address on a domain verified at https://resend.com/domains
CONTACT_FROM_EMAIL=

# The production origin: scheme and host only, with no path, query string or
# trailing slash. Canonical URLs, sitemap entries and social images all resolve
# against it. A missing or malformed value fails `npm run build`; `npm run dev`
# and `npm test` fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Runtime database: Neon pooled (-pooler) PostgreSQL URL. Preserve the provided
# sslmode=require option. Validated only on first server database use, not build.
DATABASE_URL=

# Direct PostgreSQL URL for separately approved `prisma migrate deploy`/Studio.
# Never used by the runtime or as a fallback. Offline Prisma Client and SQL
# generation needs no URL.
DATABASE_URL_UNPOOLED=

# `npm run test:integration` only. Set it in `.env.test.local` (Vitest runs with
# NODE_ENV=test, which skips .env.local). Must be a local database whose name
# starts with "portfolio" and ends in "_test", for example
# postgresql://localhost:5432/portfolio_test. Every run rebuilds it.
TEST_DATABASE_URL=

# `npm run db:diff` only, when authoring a migration. Prisma replays the committed
# migrations into this database and drops it each time, so it must be a local,
# disposable database whose name starts with "portfolio" and ends in "_shadow",
# for example postgresql://<local-user>@localhost:5432/portfolio_shadow. Prisma
# needs the user named in the URL. Never a Neon branch.
SHADOW_DATABASE_URL=

# Neon Managed Better Auth: the branch's Auth URL (Console: Project -> Branch ->
# Auth -> Configuration). https, kept exactly, including its /neondb/auth path.
# Validated only on first auth use, not at build.
NEON_AUTH_BASE_URL=

# Signs the session cookies. At least 32 characters: `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=

# The only account the dashboard admits, matched case-insensitively and only
# once its email is verified. Sign-up is closed in Neon's branch settings.
OWNER_EMAIL=
