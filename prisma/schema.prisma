// Dashboard models arrive with their features, one file per table group in
// prisma/models/. Auth tables are not migrated here: Managed Better Auth owns
// them in the neon_auth schema of each Neon branch, and prisma.config.ts marks
// neon_auth.user as external.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "neon_auth"]
}
